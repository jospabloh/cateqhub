{
  "name": "Guardian",
  "type": "object",
  "properties": {
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "x-ref": "Parish"
    },
    "name": {
      "type": "string",
      "title": "Nombre completo"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "curp": {
      "type": "string",
      "title": "CURP",
      "description": "Clave \u00danica de Registro de Poblaci\u00f3n (M\u00e9xico), 18 caracteres. Opcional."
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Correo electr\u00f3nico"
    },
    "whatsapp_opt_in": {
      "type": "boolean",
      "default": false,
      "title": "Acepta mensajes por WhatsApp"
    }
  },
  "required": [
    "parish_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}