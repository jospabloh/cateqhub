{
  "name": "JoinRequest",
  "type": "object",
  "properties": {
    "parish_id": {
      "type": "string",
      "title": "Parroquia a la que pide unirse",
      "description": "Parroquia dueña del código que usó la persona. NO da acceso por sí sola: el acceso (User.parish_id/parish_role) sólo lo escribe assign_parish_user al APROBAR, con un administrador de esa parroquia eligiendo el rol. Lo fija la función `join` desde el código, nunca el cliente.",
      "x-ref": "Parish"
    },
    "parish_name": { "type": "string", "title": "Nombre de la parroquia (copia)" },
    "user_id": {
      "type": "string",
      "title": "Cuenta que pide acceso",
      "description": "id del User, tomado de la sesión por la función `join`. Al aprobar se relee ese User: la aprobación nunca usa un id que mande el cliente."
    },
    "user_email": { "type": "string", "title": "Correo de quien pide acceso" },
    "user_name": { "type": "string", "title": "Nombre de quien pide acceso" },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": ["pending", "approved", "rejected", "cancelled"],
      "default": "pending",
      "description": "pending = esperando al administrador (la persona no ve datos); approved/rejected = decisión del administrador; cancelled = la retiró la persona o dejó de aplicar (ya entró a otra parroquia)."
    },
    "parish_role_assigned": { "type": "string", "title": "Rol con el que se aprobó", "enum": ["admin", "catequist"] },
    "decided_by": { "type": "string", "title": "Quién resolvió (correo)" },
    "decided_at": { "type": "string", "format": "date-time", "title": "Cuándo se resolvió" },
    "reject_reason": { "type": "string", "title": "Motivo del rechazo (opcional)" }
  },
  "required": ["parish_id", "user_id", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
