{
  // Módulo 18 del estándar: una fila por (parish_id, user_id, parish_role).
  //
  // NO reemplaza a User.parish_id — el estándar es explícito en eso: la RLS y
  // las funciones de servicio siguen acotando por el ÚNICO parish_id
  // persistido en el perfil del llamante. Esto es el registro de TODAS las
  // parroquias a las que pertenece, que es distinto de en cuál está actuando
  // ahora. Un catequista que sirve en dos parroquias tiene dos filas aquí y un
  // solo parish_id a la vez.
  //
  // La diferencia con un `members[]` embebido en Parish, que es lo que el
  // estándar descarta: `read` va por {{user.id}}, no por parroquia. Eso es
  // justo lo que permite a alguien LISTAR las parroquias en las que no está
  // activo ahora mismo — sin eso no hay selector posible, porque la RLS de
  // Parish sólo deja ver la propia.
  "name": "Membership",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "Usuario",
      "description": "Dueño de la pertenencia. La lectura va por este campo contra {{user.id}}: cada quien ve sus propias membresías y las de nadie más.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "email": {
      "type": "string",
      "title": "Correo",
      "description": "Copia del correo al crear la fila, para poder mostrar el listado sin resolver el User. No es la llave: la llave es user_id.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "parish_name": {
      "type": "string",
      "title": "Nombre de la parroquia",
      "description": "Copia del nombre al crear o refrescar la fila. Existe porque el selector tiene que nombrar parroquias que el usuario NO puede leer todavía: la RLS de Parish sólo le deja ver aquella en la que está activo. Sin esta copia, el selector mostraría ids.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "parish_role": {
      "type": "string",
      "title": "Rol en esa parroquia",
      "enum": ["admin", "catequist"],
      "default": "catequist",
      "description": "El rol que le corresponde EN ESA parroquia. Al cambiar de parroquia se re-deriva de aquí, nunca se arrastra el de la anterior.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "active": {
      "type": "boolean",
      "title": "Vigente",
      "default": true,
      "description": "false al salir de la parroquia o al ser removido. No se borra la fila: saber que alguien estuvo es útil para reincorporarlo, y un borrado real perdería el rastro.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": ["user_id", "parish_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } },
    // Por usuario, NO por parroquia — es el punto entero de esta entidad.
    // La rama de rol de servicio es obligatoria (scripts/lib/entity-rls-rules.mjs):
    // sin ella asServiceRole.filter() devuelve cero filas y las funciones
    // fallan en silencio.
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
