{
  "name": "Child",
  "type": "object",
  "properties": {
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "x-ref": "Parish"
    },
    "group_id": {
      "type": "string",
      "title": "Grupo",
      "x-ref": "Group"
    },
    "group_changed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Último cambio de grupo",
      "description": "Se actualiza cuando group_id cambia — para avisar a catequistas que el QR físico puede estar desactualizado."
    },
    "name": {
      "type": "string",
      "title": "Nombre del ni\u00f1o"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de nacimiento"
    },
    "curp": {
      "type": "string",
      "title": "CURP",
      "description": "Clave \u00danica de Registro de Poblaci\u00f3n (M\u00e9xico), 18 caracteres. Opcional."
    },
    "qr_token": {
      "type": "string",
      "title": "Token QR (UUID)",
      "description": "\u00danico e infalsificable, generado al crear el ni\u00f1o"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activo"
    }
  },
  "required": [
    "parish_id",
    "name",
    "qr_token"
  ],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [
            { "data.parish_id": "{{user.data.parish_id}}" },
            { "$or": [
                { "user_condition": { "data.parish_plan": "free" } },
                { "user_condition": { "data.parish_license_status": "active" } },
                { "user_condition": { "data.parish_license_status": "read_only" } }
            ] }
        ] }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}