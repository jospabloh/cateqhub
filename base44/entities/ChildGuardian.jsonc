{
  "name": "ChildGuardian",
  "type": "object",
  "properties": {
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "x-ref": "Parish"
    },
    "child_id": {
      "type": "string",
      "title": "Ni\u00f1o",
      "x-ref": "Child"
    },
    "guardian_id": {
      "type": "string",
      "title": "Tutor",
      "x-ref": "Guardian"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "padre",
        "madre",
        "tutor",
        "otro"
      ],
      "default": "tutor",
      "title": "Relaci\u00f3n"
    },
    "pickup_authorized": {
      "type": "boolean",
      "default": true,
      "title": "Autorizado para recoger"
    }
  },
  "required": [
    "parish_id",
    "child_id",
    "guardian_id"
  ],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [
            { "data.parish_id": "{{user.data.parish_id}}" },
            { "$or": [
                { "user_condition": { "data.parish_license_status": "active" } },
                { "user_condition": { "data.parish_license_status": "read_only" } }
            ] }
        ] }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [
            { "data.parish_id": "{{user.data.parish_id}}" },
            { "user_condition": { "data.parish_license_status": "active" } }
        ] }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}