{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "x-ref": "Parish"
    },
    "group_id": {
      "type": "string",
      "title": "Grupo",
      "x-ref": "Group"
    },
    "child_id": {
      "type": "string",
      "title": "Ni\u00f1o",
      "x-ref": "Child"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de la clase"
    },
    "recorded_by": {
      "type": "string",
      "title": "Registrado por (usuario)",
      "x-ref": "User"
    }
  },
  "required": [
    "parish_id",
    "group_id",
    "child_id",
    "date",
    "recorded_by"
  ],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [
            { "data.parish_id": "{{user.data.parish_id}}" },
            { "$or": [
                { "user_condition": { "data.parish_plan": "free" } },
                { "user_condition": { "data.parish_license_status": "active" } },
                { "user_condition": { "data.parish_license_status": "read_only" } }
            ] }
        ] }
      ]
    },
    "update": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}