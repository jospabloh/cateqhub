{
  "name": "Attendance",
  "properties": {
    "child_id": {
      "title": "Ni\u00f1o",
      "type": "string",
      "x-ref": "Child"
    },
    "date": {
      "format": "date",
      "title": "Fecha de la clase",
      "type": "string"
    },
    "group_id": {
      "title": "Grupo",
      "type": "string",
      "x-ref": "Group"
    },
    "parish_id": {
      "title": "Parroquia",
      "type": "string",
      "x-ref": "Parish"
    },
    "recorded_by": {
      "title": "Registrado por (usuario)",
      "type": "string",
      "x-ref": "User"
    }
  },
  "required": [
    "parish_id",
    "group_id",
    "child_id",
    "date",
    "recorded_by"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.parish_id": "{{user.data.parish_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "data.parish_license_status": "active"
                  }
                },
                {
                  "user_condition": {
                    "data.parish_license_status": "read_only"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.parish_id": "{{user.data.parish_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}