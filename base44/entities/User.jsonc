{
  "properties": {
    "role": {
      "type": "string",
      "description": "Rol de plataforma: admin = propietario de la app; user = cualquier persona invitada. No define permisos por parroquia.",
      "enum": [
        "admin",
        "user"
      ]
    },
    "parish_role": {
      "type": "string",
      "title": "Rol en la parroquia",
      "description": "Rol dentro del tenant (parroquia): admin = administrador de la parroquia, catequist = catequista",
      "enum": [
        "admin",
        "catequist"
      ],
      "default": "catequist",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "parish_id": {
      "type": "string",
      "title": "Parroquia",
      "description": "Tenant al que pertenece el usuario (aislamiento de datos). Solo se asigna vía las funciones create_parish/assign_parish_user (rol de servicio) — un usuario no puede auto-asignarse a otra parroquia.",
      "x-ref": "Parish",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "group_id": {
      "type": "string",
      "title": "Grupo asignado",
      "description": "Si es catequista, el grupo que dirige",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "perm_ninos_ver_todos": {
      "type": "boolean",
      "title": "Permiso: ver niños de todos los grupos/libros",
      "default": false,
      "description": "Espejo de PermissionProfile (ninos:ver_todos_los_grupos), sincronizado por sync_catequist_permissions/assign_parish_user. Un registro sin este campo se trata como false — mismo comportamiento que el valor por defecto del registro de permisos.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "perm_ninos_cambiar_grupo": {
      "type": "boolean",
      "title": "Permiso: cambiar el grupo/libro de un niño",
      "default": false,
      "description": "Espejo de PermissionProfile (ninos:cambiar_grupo). Ausente = false, igual que el valor por defecto.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "perm_ninos_dar_de_baja": {
      "type": "boolean",
      "title": "Permiso: dar de baja / reactivar niños",
      "default": false,
      "description": "Espejo de PermissionProfile (ninos:dar_de_baja). Ausente = false, igual que el valor por defecto.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "perm_escanear_restringido": {
      "type": "boolean",
      "title": "Restringido a escanear solo su propio grupo/libro",
      "default": false,
      "description": "Invertido a propósito: PermissionProfile guarda escanear:cualquier_grupo (default true); este campo guarda lo contrario para que un registro SIN este campo (todo usuario existente antes de esta migración) se comporte igual que el default real (sin restricción) sin necesitar un backfill.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "perm_tutores_restringido": {
      "type": "boolean",
      "title": "Restringido para agregar tutores",
      "default": false,
      "description": "Invertido a propósito, igual que perm_escanear_restringido: PermissionProfile guarda tutores:agregar (default true); ausente = sin restricción, igual que el default real.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        { "id": "{{user.id}}" },
        { "data.parish_id": "{{user.data.parish_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
