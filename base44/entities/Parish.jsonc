{
  "name": "Parish",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "admin_contact": {
      "type": "string",
      "title": "Contacto del administrador"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activa"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "Nivel de suscripción. Ya no existe un plan gratuito permanente: toda parroquia nueva arranca en \"premium\" con una prueba gratuita de 30 días (ver premium_period_end_at), con acceso completo a toda la app (núcleo + Tutores/mensajería/tareas/pulseras). \"free\" ya no se asigna a parroquias nuevas — solo lo escribe, como estado terminal, el borrado automático de datos Premium (license-delete-premium-data en Mission Control) tras deletion_eligible: en \"free\" el núcleo (asistencia, niños, grupos, reportes) vuelve a ser de solo lectura hasta reactivarlo, y Tutores/mensajería/tareas/pulseras ya no aplican. Se activa/reactiva desde Mission Control (rol de servicio) o el panel de Base44 — un admin de parroquia puede verlo pero no cambiarlo por sí mismo.",
      "enum": ["free", "premium"],
      "default": "premium",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "license_status": {
      "type": "string",
      "title": "Estado de licencia",
      "description": "Solo aplica mientras plan=premium (prueba de 30 días o pago confirmado). Ciclo: active → read_only → access_denied → deletion_eligible si el período (premium_period_end_at) vence sin renovarse — aplica a TODA la app (núcleo incluido), no solo a Tutores. Escrito exclusivamente por Mission Control (rol de servicio) vía el puente acaciaControl — nunca a mano desde el panel de Base44, porque el espejo en User (parish_license_status) quedaría desincronizado.",
      "enum": ["active", "read_only", "access_denied", "deletion_eligible"],
      "default": "active",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "premium_period_end_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fin del periodo vigente (prueba o pago)",
      "description": "Al crear la parroquia se estampa a 30 días (prueba gratuita). Al confirmarse un pago, Mission Control lo recorre. El cron license-lifecycle usa esta fecha para iniciar el ciclo active → read_only → access_denied → deletion_eligible si no se renueva.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "read_only_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo está en solo lectura",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "access_denied_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo se denegó el acceso",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "deletion_eligible_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo es candidata a borrado",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "export_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Exportación de datos Premium confirmada",
      "description": "Se escribe únicamente desde la función confirm_premium_export (rol de servicio) — nunca editable directo, para que no se pueda falsificar la confirmación.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "export_confirmed_by": {
      "type": "string",
      "title": "Quién confirmó la exportación (correo)",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_accepted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Aviso de manejo de datos sensibles aceptado",
      "description": "Se estampa una sola vez, al crear la parroquia, desde create_parish (rol de servicio). Es evidencia de cumplimiento LFPDPPP — sin este candado de escritura, la RLS de update de Parish (más abajo) permite a cualquier admin de esa parroquia reescribir su propio registro de consentimiento a mano.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_accepted_by": {
      "type": "string",
      "title": "Quién aceptó el aviso (correo)",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_terms_version": {
      "type": "string",
      "title": "Versión del aviso aceptado",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    }
  }
}