{
  "name": "Parish",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "admin_contact": {
      "type": "string",
      "title": "Contacto del administrador"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activa"
    },
    "join_code": {
      "type": "string",
      "title": "Código para unirse",
      "description": "Código (ABCD-EFGH) que un catequista escribe para PEDIR acceso. No da acceso: crea una solicitud pendiente que un administrador aprueba o rechaza (JoinRequest). Sólo lo escribe assign_parish_user (acción join_code, rol de servicio); sin este candado, la RLS de update de Parish deja a cualquier administrador de la parroquia fijar un código a mano. Los miembros de la parroquia pueden leerlo.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "Nivel de suscripción. \"free\" es un plan permanente y normal (no una penalización): núcleo completo (asistencia QR, alta de parroquia/grupos/niños, reportes) sin vencimiento, con tope de 50 niños activos (FREE_PLAN_CHILD_CAP en src/lib/premium.js) y sin Tutores/mensajería/tareas/pulseras. Toda parroquia nueva arranca en \"premium\" con una prueba gratuita de 30 días (ver premium_period_end_at), con acceso completo y sin el tope de niños. Si ese período (prueba o pago) vence sin renovarse: con ≤50 niños activos, Mission Control baja la parroquia directo a \"free\" (sin fricción); con más de 50, entra al ciclo de license_status (ver abajo) hasta que se pague el nivel Premium que le toque. Se activa/reactiva desde Mission Control (rol de servicio) o el panel de Base44 — un admin de parroquia puede verlo pero no cambiarlo por sí mismo.",
      "enum": ["free", "premium"],
      "default": "premium",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "license_status": {
      "type": "string",
      "title": "Estado de licencia",
      "description": "Solo aplica mientras plan=premium Y la parroquia tiene más de 50 niños activos al vencer su período (si tiene 50 o menos, Mission Control la baja directo a plan=\"free\" sin pasar por este ciclo). Ciclo: active → read_only → access_denied → deletion_eligible si el período (premium_period_end_at) vence sin renovarse — aplica a TODA la app (núcleo incluido), no solo a Tutores, mientras dura. Escrito exclusivamente por Mission Control (rol de servicio) vía el puente acaciaControl — nunca a mano desde el panel de Base44, porque el espejo en User (parish_license_status) quedaría desincronizado.",
      "enum": ["active", "read_only", "access_denied", "deletion_eligible"],
      "default": "active",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "premium_period_end_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fin del periodo vigente (prueba o pago)",
      "description": "Al crear la parroquia se estampa a 30 días (prueba gratuita). Al confirmarse un pago, Mission Control lo recorre. El cron license-lifecycle usa esta fecha para decidir, al vencer: baja directa a plan=\"free\" (≤50 niños activos) o el ciclo active → read_only → access_denied → deletion_eligible (>50).",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "read_only_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo está en solo lectura",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "access_denied_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo se denegó el acceso",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "deletion_eligible_since": {
      "type": "string",
      "format": "date-time",
      "title": "Desde cuándo es candidata a borrado",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "export_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Exportación de datos Premium confirmada",
      "description": "Se escribe únicamente desde la función confirm_premium_export (rol de servicio) — nunca editable directo, para que no se pueda falsificar la confirmación.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "export_confirmed_by": {
      "type": "string",
      "title": "Quién confirmó la exportación (correo)",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_accepted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Aviso de manejo de datos sensibles aceptado",
      "description": "Se estampa una sola vez, al crear la parroquia, desde create_parish (rol de servicio). Es evidencia de cumplimiento LFPDPPP — sin este candado de escritura, la RLS de update de Parish (más abajo) permite a cualquier admin de esa parroquia reescribir su propio registro de consentimiento a mano.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_accepted_by": {
      "type": "string",
      "title": "Quién aceptó el aviso (correo)",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "data_processing_terms_version": {
      "type": "string",
      "title": "Versión del aviso aceptado",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "implementation_requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Implementación asistida solicitada",
      "description": "Autoservicio: cualquier admin de la parroquia puede estampar esto desde Premium.jsx al pedir la implementación asistida (pago único, ver implementation_requested_tier). Es solo una señal de interés, no activa nada — ACACIA confirma el pago por WhatsApp/factura y recién entonces marca implementation_status=\"completed\" (rol de servicio, vía Mission Control). Sin rls.write explícito: hereda la regla de update de Parish (admin de la propia parroquia, o rol de servicio)."
    },
    "implementation_requested_tier": {
      "type": "string",
      "title": "Tramo de implementación solicitado",
      "enum": ["hasta_150", "151_350", "351_mas"],
      "description": "Tramo de precio (ver IMPLEMENTATION_TIERS en src/lib/premium.js y acaciaco-site/apps/cateqhub.html — mismos tramos en los tres) según niños activos al momento de solicitarla. Autoservicio, igual que implementation_requested_at."
    },
    "implementation_status": {
      "type": "string",
      "title": "Estado de la implementación asistida",
      "enum": ["none", "requested", "completed"],
      "default": "none",
      "description": "\"completed\" lo escribe únicamente ACACIA (rol de servicio, vía Mission Control) tras confirmar el pago del cargo único — un admin de parroquia puede solicitarla (implementation_requested_at) pero no marcarse a sí mismo como completada.",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "implementation_completed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Implementación asistida completada",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    },
    "support_priority_addon_requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Soporte prioritario solicitado",
      "description": "Autoservicio: señal de interés en el add-on de soporte prioritario ($250 MXN/mes, sube el tope de prioridad de ticket a \"urgente\") desde Premium.jsx. No activa el beneficio por sí sola — ver support_priority_addon."
    },
    "support_priority_addon": {
      "type": "boolean",
      "title": "Soporte prioritario activo",
      "default": false,
      "description": "Sube el tope de prioridad seleccionable en un ticket de SupportTicket a \"urgent\" (ver src/lib/premium.js maxTicketPriority y SupportTickets.jsx). Solo ACACIA lo activa (rol de servicio, vía Mission Control) tras confirmar el pago mensual del add-on; se espeja a User.parish_support_priority_addon con el mismo mecanismo que plan/license_status (acción license.set, params.mirror).",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "id": "{{user.data.parish_id}}"
            },
            {
              "user_condition": {
                "data.parish_role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}