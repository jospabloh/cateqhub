{
  "name": "Parish",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "admin_contact": {
      "type": "string",
      "title": "Contacto del administrador"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activa"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    }
  }
}