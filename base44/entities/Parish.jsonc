{
  "name": "Parish",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "admin_contact": {
      "type": "string",
      "title": "Contacto del administrador"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Activa"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "description": "Nivel de suscripción. CateqHub es free por default (sin vencimiento); el límite de niños del plan free aún no está definido. Se activa a premium desde Mission Control (rol de servicio) o el panel de Base44 — un admin de parroquia puede verlo pero no activarlo por sí mismo.",
      "enum": ["free", "premium"],
      "default": "free",
      "rls": { "write": { "user_condition": { "role": "admin" } } }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.parish_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.parish_role": "admin"
          }
        }
      ]
    }
  }
}